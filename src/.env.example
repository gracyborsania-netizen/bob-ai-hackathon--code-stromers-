# PharmaGuard AI — Environment Variables
# =========================================
# Copy this file to .env and fill in your credentials.
# NEVER commit .env to version control.
#
# IBM Bob / watsonx AI Integration
# ---------------------------------
# Set these variables to enable the IBM Bob AI assistance features.
# Leave them empty to run PharmaGuard AI in offline/fallback mode.
# The application works fully without these credentials.

BOB_API_URL=
BOB_API_KEY=
BOB_MODEL=ibm/granite-13b-instruct-v2
