# .gitignore — PharmaGuard AI

# Environment / secrets — NEVER commit
.env
*.env

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
*.egg

# Virtual environments
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# Test / coverage cache
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/

# IDE / OS
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

# Node (not used but safe to include)
node_modules/

# Streamlit cache
.streamlit/

# Jupyter
.ipynb_checkpoints/
*.ipynb

# Distribution / packaging
MANIFEST
*.spec

# Do NOT ignore:
# - src/ source files
# - tests/
# - docs/
# - demo/screenshots/
# - presentation/
# - README.md
# - CONTRIBUTING.md
# - submission.yaml
# - src/.env.example  (template file — safe to commit, contains no secrets)
